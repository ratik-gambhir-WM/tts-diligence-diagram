flowchart TB

subgraph applicationArchitecture[APPLICATION ARCHITECTURE]
subgraph onPremisesCustomer[On-Premises Customer]

    serverServices --> enterpriseSystems
    serverServices --> directorySync
    serverServices --> proveIdWebApi
    serverServices --> auditReporting
    serverServices --> adminUi
    serverServices --> databaseOracle19c

    windowsEndpoint --> proveIdWebApi
    windowsEndpoint --> serverServices
    macEndpoint --> proveIdWebApi
    macEndpoint --> serverServices
    embeddedEndpoint --> proveIdWebApi
    embeddedEndpoint --> serverServices
    webEndpoint --> proveIdWebApi
    webEndpoint --> serverServices

    subgraph appliance[Appliance]
        subgraph adminUi[Admin UI]
            adminUiTech[XSLT, React 19]
        end

        subgraph auditReporting[Audit and Reporting]
        end

        subgraph proveIdWebApi[ProveID WebAPI]
            proveIdWebApiTech[Java]
        end

        subgraph directorySync[Directory & Sync]
            directorySyncTech[Java]
        end

        subgraph serverServices[Server Services]
            serverServicesTech[Java]
        end

        databaseOracle19c[(Db<br/>Oracle 19c)]
    end
    appliance:::externalSystem

    subgraph enterpriseSystems[Enterprise Systems]
        subgraph msActiveDirectory[MS Active Directory]
            msActiveDirectoryProtocol[Kerberos/LDAP]
        end
        subgraph radiusMfa[RADIUS MFA]
        end
        subgraph windowsApps[Windows Apps]
            windowsAppsTargets[SSO Targets]
        end
        subgraph clinicalApps[Clinical Apps]
            clinicalAppsExamples[EHR, eMAR, CPOE]
        end
        subgraph workflows[Workflows]
            workflowsScope[Controlled Substances]
        end
        subgraph webAppsVdi[Web Apps + VDI]
            webAppsVdiStack[Citrix / RDS / Horizon]
        end
    end
    enterpriseSystems:::externalSystem

    subgraph windowsEndpoint[Windows Endpoint]
        subgraph windowsAgentService[Agent Service]
            windowsAgentServiceTech[C/C++, Windows]
        end
        subgraph windowsCredentialProvider[Credential Provider]
            windowsCredentialProviderScope[Device Integrations]
        end
        subgraph windowsDeviceIntegrations[Device Integrations]
            windowsDeviceIntegrationsTypes[Prox, Bio, MFA]
        end
    end
    windowsEndpoint:::externalSystem

    subgraph macEndpoint[Mac Endpoint]
        subgraph macAgentService[Agent Service]
            macAgentServiceTech[C++/C, MacOS]
        end
    end
    macEndpoint:::externalSystem

    subgraph embeddedEndpoint[Embedded]
        subgraph embeddedClient[Client]
            embeddedClientTech[C++/C, ProveID]
        end
    end
    embeddedEndpoint:::externalSystem

    subgraph webEndpoint[Web]
        subgraph webWorkflows[Workflows]
            webWorkflowsScope[Controlled Substances]
        end
    end
    webEndpoint:::externalSystem

end
end

%% Reusable style definitions
classDef wmTitle fill:transparent,stroke:transparent,color:#070154,font-size:34px,font-weight:bold,font-family:Arial,padding:100px,margin:100px,white-space:nowrap
classDef wmDarkContainer fill:#070154,color:#FFFFFF,stroke:#070154,stroke-width:1px,font-family:Arial,font-weight:bold
classDef wmDescriptionLight fill:transparent,color:#FFFFFF,stroke:none,font-family:Arial,font-size:13px,font-weight:regular
classDef externalSystem fill:#CED7E6,color:#070154,stroke:#50658E,stroke-width:1px,font-family:Arial
classDef internalContainer fill:#FFFFFF,color:#070154,stroke:#50658E,stroke-width:1px,font-family:Arial
linkStyle default stroke:#50658E,stroke-width:1.5px,color:#50658E

%% Class assignments
class applicationArchitecture,onPremisesCustomer wmTitle
class adminUi,auditReporting,proveIdWebApi,directorySync,serverServices,databaseOracle19c,msActiveDirectory,radiusMfa,windowsApps,clinicalApps,workflows,webAppsVdi,windowsAgentService,windowsCredentialProvider,windowsDeviceIntegrations,macAgentService,embeddedClient,webWorkflows wmDarkContainer
class adminUiTech,proveIdWebApiTech,directorySyncTech,serverServicesTech,msActiveDirectoryProtocol,windowsAppsTargets,clinicalAppsExamples,workflowsScope,webAppsVdiStack,windowsAgentServiceTech,windowsCredentialProviderScope,windowsDeviceIntegrationsTypes,macAgentServiceTech,embeddedClientTech,webWorkflowsScope wmDescriptionLight
