{
  "name": "tts-mermaid",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tts-mermaid/web",
    "web:dev": "npm run dev --workspace @tts-mermaid/web",
    "server:dev": "npm run dev --workspace @tts-mermaid/server",
    "server:start": "npm run start --workspace @tts-mermaid/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "server:typecheck": "npm run typecheck --workspace @tts-mermaid/server",
    "test": "npm run test --workspaces --if-present",
    "server:test": "npm run test --workspace @tts-mermaid/server",
    "build": "npm run build --workspace @tts-mermaid/web",
    "pptx:to-json": "npm run pptx:to-json --workspace @tts-mermaid/server --"
  }
}
